flowchart LR
    manager(["Showroom manager"])
    researcher(["Researcher"])

    FE["<b>Manager Web Interface</b><br/>React + TypeScript<br/>new order, estimate, order list,<br/>order details, factory status"]
    BE["<b>Backend API</b><br/>FastAPI<br/>order validation, estimation,<br/>factory status, catalog"]
    DB[("<b>Database</b><br/>PostgreSQL<br/>orders, estimates, factory state,<br/>catalog, experiment results")]
    TWIN["<b>Digital Twin</b><br/>SimPy<br/>production line model,<br/>Monte Carlo date distribution"]

    RUN["<b>Experiment Runner</b><br/>order generator, metrics,<br/>statistical tests"]
    BASE["<b>Baselines B1 and B2</b><br/>simple date estimates"]
    EMU["<b>Factory Emulator</b><br/>independent and more detailed,<br/>gives actual completion dates"]

    manager -->|"browser"| FE
    FE -->|"REST / JSON"| BE
    BE ---->|"SQL"| DB
    BE -->|"function call"| TWIN
    EMU -->|"status updates<br/>(simulated synchronisation)"| DB

    researcher -->|"command line"| RUN
    RUN -->|"same orders"| TWIN
    RUN -->|"same orders"| BASE
    RUN -->|"asks for actual dates"| EMU
    RUN -->|"results"| DB

    classDef person fill:#fff3d6,stroke:#b07d00,color:#222
    classDef comp fill:#e8f0fe,stroke:#3367d6,color:#111
    classDef store fill:#e6f4ea,stroke:#1e8e3e,color:#111
    classDef eval fill:#fce8e6,stroke:#c5221f,color:#111
    class manager,researcher person
    class FE,BE,TWIN comp
    class DB store
    class RUN,BASE,EMU eval
